<div class="re-request">
  <p class="re-request-intro">{{localize "ROLLENSEMBLECOC7.Request.Intro"}}</p>
  <div class="re-request-card">
    <img src="{{img}}" alt="{{name}}" />
    <div class="re-request-info">
      <span class="re-request-name">{{name}}</span>
      <span class="re-request-skill">{{skillLabel}}</span>
      <span class="re-request-target">{{localize "ROLLENSEMBLECOC7.Request.Target"}} : {{effectiveSkill}}%</span>
    </div>
  </div>
  <button type="button" class="re-request-roll" data-action="roll">
    <i class="fa-solid fa-dice-d10"></i> {{localize "ROLLENSEMBLECOC7.Request.RollButton"}}
  </button>
</div>
